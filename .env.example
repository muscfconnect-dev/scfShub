# Local: copy to .env.local. Production: set these in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
CRON_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=scf-hub
BREVO_API_KEY=
EMAIL_FROM=hello@your-verified-domain.com
EMAIL_FROM_NAME=SCF Students Hub
# Leave false on a direct connection; Vercel enables trusted headers automatically.
TRUST_PROXY_HEADERS=false
# Optional Cloudflare Turnstile bot protection. Set both to enable on public forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
